# Copy to .env and replace every `__GENERATE_ME__` with a strong random secret.
#
# Generate with:    openssl rand -base64 32
# Or run:           ./deployment/scripts/generate_env.sh > .env

# --- Database ---
# Root password is only used at init; lock down externally afterwards.
DB_ROOT_PASSWORD=__GENERATE_ME__
DB_NAME=nixfact
DB_USER=nixfact
DB_PASSWORD=__GENERATE_ME__

# --- Redis ---
# Same password for both cache and queue keeps the compose file simple;
# split them if your threat model demands it.
REDIS_PASSWORD=__GENERATE_ME__

# --- Site ---
SITE_NAME=nixfact.localhost
HTTP_PORT=8080
NIXFACT_TAG=local

# --- Mollie (optional, configure in NixFact Instellingen at runtime) ---
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxx

# --- Ponto (optional, per-koppeling in the NixFact Bank Koppeling doctype) ---
# PONTO_CLIENT_ID=
# PONTO_CLIENT_SECRET=
