# Copy to .env and replace every `__GENERATE_ME__` with a strong random secret.
#
# Generate with:    openssl rand -base64 32
# Or run:           ./deployment/scripts/generate_env.sh > .env

# --- Database ---
# Root password is only used at init; lock down externally afterwards.
DB_ROOT_PASSWORD=__GENERATE_ME__
DB_NAME=nixfact
DB_USER=nixfact
DB_PASSWORD=__GENERATE_ME__

# --- Redis ---
# Same password for both cache and queue keeps the compose file simple;
# split them if your threat model demands it.
REDIS_PASSWORD=__GENERATE_ME__

# --- Site ---
SITE_NAME=nixfact.localhost
HTTP_PORT=8080
NIXFACT_TAG=local
# Interface the web port binds to. 127.0.0.1 for dev (loopback only); set to
# 0.0.0.0 in the LXC so the VPS Caddy can reach it over Tailscale.
BIND_HOST=127.0.0.1
# Admin password for the very first `bench new-site`. Only consumed by init.sh
# via `docker compose run -e ADMIN_PASSWORD=...`; leave blank otherwise.
ADMIN_PASSWORD=
# Defaults to REDIS_QUEUE if unset; uncomment to point socketio elsewhere.
# REDIS_SOCKETIO=

# --- Backups ---
# Host directory the nightly backup writes to, bind-mounted at /backups. On the
# production LXC this is the HDD-backed mount that borgmatic then picks up.
# Must be writable by uid 1000 (the frappe user inside the container).
BACKUP_DIR=/mnt/nixfact/backups
# Public half of the age key the backup is encrypted to. The backup contains
# Frappe's encryption_key, which decrypts every stored Mollie/Ponto credential,
# so it is never written unencrypted. Only the recipient belongs here — keep the
# private key off this host (production: /root/.secrets/nixfact-backup.agekey on
# the Proxmox node). Generate a pair with: age-keygen -o backup.agekey
# WITHOUT THE PRIVATE KEY THE BACKUPS CANNOT BE RESTORED. Back it up off-box.
NIXFACT_AGE_RECIPIENT=

# --- Mollie (optional, configure in NixFact Instellingen at runtime) ---
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxx

# --- Ponto (optional, per-koppeling in the NixFact Bank Koppeling doctype) ---
# PONTO_CLIENT_ID=
# PONTO_CLIENT_SECRET=
