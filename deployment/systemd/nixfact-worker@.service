[Unit]
Description=NixFact RQ worker (queue: %i)
After=network-online.target nixfact.service mariadb.service redis.service
Requires=nixfact.service mariadb.service redis.service

[Service]
Type=simple
User=frappe
Group=frappe
WorkingDirectory=/home/frappe/frappe-bench
EnvironmentFile=-/etc/nixfact/nixfact.env

# Instance name is the queue (short, long, default).
ExecStart=/home/frappe/.local/bin/bench worker --queue %i

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/frappe/frappe-bench/sites /home/frappe/frappe-bench/logs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
