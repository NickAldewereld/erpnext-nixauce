[Unit]
# Runs on the Docker host (LXC 218), not inside the bench.
#
# This unit was previously written for a bare-metal bench: User=frappe,
# WorkingDirectory=/home/frappe/frappe-bench, ExecStart invoking backup.sh
# directly. None of those exist on this host — that path lives inside the
# container — so the unit could only ever have failed. The backup has to run
# where bench lives, so we exec into the web container, which carries the
# script, age, and the /backups bind-mount.
#
# The archive is encrypted inside the container before it is written out, so it
# never touches this host's disk in the clear. It bundles the site's
# site_config_backup.json, which carries encryption_key and db_password — the
# key that decrypts every stored Mollie/Ponto credential.
Description=NixFact daily backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/nixfact/deployment/docker
# Carries NIXFACT_AGE_RECIPIENT. The matching private key is deliberately absent
# from this host — it lives at /root/.secrets/nixfact-backup.agekey on the
# Proxmox node. age needs only the public half to encrypt, so rooting this
# container does not decrypt yesterday's backups.
EnvironmentFile=/etc/nixfact/backup.env
ExecStart=/usr/bin/docker compose exec -T \
    -e NIXFACT_BACKUP_ENCRYPTION=age \
    -e NIXFACT_AGE_RECIPIENT=${NIXFACT_AGE_RECIPIENT} \
    nixfact /backup.sh /backups
# A --with-files dump of a large site is slow; oneshot must not be reaped early.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
